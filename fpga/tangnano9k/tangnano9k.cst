IO_LOC "clk" 52;
IO_PORT "clk" PULL_MODE=UP;

IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;

IO_LOC "btn" 3;
IO_PORT "btn" PULL_MODE=UP;

IO_LOC "reset_btn" 4;
IO_PORT "reset_btn" PULL_MODE=UP;

// FPGA_TX is wired to the onboard BL702 USB-UART bridge.
IO_LOC "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE = LVCMOS33;

// BL702 USB-UART bridge to FPGA receiver.
IO_LOC "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE = LVCMOS33;
